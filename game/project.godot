[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/size.mobile=2048
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.27, 0.62, 0.62, 1)

[shader_globals]

occlude_center={
"type": "vec2",
"value": Vector2(0.5, 0.5)
}
occlude_depth={
"type": "float",
"value": 0.0
}
occlude_radius={
"type": "float",
"value": 0.12
}
night={
"type": "float",
"value": 0.0
}
wind_time={
"type": "float",
"value": 0.0
}
player_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}

[physics]

common/physics_interpolation=true
